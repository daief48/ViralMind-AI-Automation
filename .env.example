# ─── VIRALMIND environment configuration ────────────────────────────────────
# Copy to .env and fill in real values. NEVER commit the .env file.

# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Boot BullMQ workers inside the API process (true in development / single-node deployments)
RUN_WORKERS=true
# Allowed browser origin for CORS
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://viralmind:viralmind@localhost:5432/viralmind?schema=public

# Queue system (Redis)
REDIS_URL=redis://localhost:6379

# Authentication — generate with: openssl rand -hex 32
JWT_SECRET=change-me-generate-a-long-random-secret
JWT_EXPIRES_IN=7d

# Encryption key for Facebook tokens & secrets at rest (AES-256-GCM) — openssl rand -hex 32
ENCRYPTION_KEY=change-me-generate-a-long-random-key

# Seeded admin account (used by `npm run db:seed`)
SEED_ADMIN_EMAIL=admin@viralmind.local
SEED_ADMIN_PASSWORD=ChangeMe#2026!

# ─── AI (Gemini) — Phase 3 ────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── Facebook / Meta Graph API — Phase 2 ─────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4000/api/v1/auth/facebook/callback
META_API_VERSION=v21.0
# Token used to verify webhook subscription handshakes (you choose this value)
META_WEBHOOK_VERIFY_TOKEN=

# ─── Image generation — Phase 4 ───────────────────────────────────────────────
IMAGE_PROVIDER_API_KEY=

# ─── Market data — Phase 3 (provider abstraction) ─────────────────────────────
MARKET_DATA_API_KEY=

# ─── Object storage for generated images (S3-compatible) — Phase 4 ───────────
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
